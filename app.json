{
  "expo": {
    "name": "Split The G",
    "slug": "split-the-g-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splittheg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rixouu.splittheg"
    },
    "android": {
      "package": "com.rixouu.splittheg",
      "adaptiveIcon": {
        "backgroundColor": "#050608",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "siteUrl": "https://split-the-g.vercel.app",
      "apiBaseUrl": "https://split-the-g.vercel.app",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "googleMapsApiKey": "",
      "posthogKey": "",
      "posthogHost": "https://us.i.posthog.com",
      "eas": {
        "projectId": "af125645-2d8c-473c-b8ef-addd8a830689"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
