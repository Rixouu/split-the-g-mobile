{
  "expo": {
    "name": "Split The G",
    "slug": "split-the-g",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splittheg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rixouu.splittheg",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rixouu.splittheg",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Split The G uses your location once to confirm you are at the selected venue when saving details."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Split The G uses the camera to line up your pint and detect the Guinness G before scoring.",
          "microphonePermission": "Split The G uses the microphone only when you record video.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "siteUrl": "https://www.split-the-g.app",
      "apiBaseUrl": "https://www.split-the-g.app",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "googleMapsApiKey": "",
      "posthogKey": "",
      "posthogHost": "https://us.i.posthog.com",
      "eas": {
        "projectId": "af125645-2d8c-473c-b8ef-addd8a830689"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
